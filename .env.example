# ============================================
# Hermes Chat - Configuração de Ambiente
# ============================================

# URL base da API do Hermes Gateway
# Padrão: http://localhost:5001
VITE_HERMES_API_URL=http://localhost:5001

# API Key para autenticação (opcional)
# Deixe vazio se o gateway não requerer autenticação
VITE_HERMES_API_KEY=

# Timeout padrão para requisições (em ms)
VITE_HERMES_TIMEOUT=30000

# Habilitar modo debug (true/false)
VITE_DEBUG=false

# Modelo padrão para chat
VITE_DEFAULT_MODEL=gpt-4

# ============================================
# Configurações de Desenvolvimento
# ============================================

# Porta do Vite dev server
# VITE_PORT=1420

# Host do Vite dev server
# VITE_HOST=localhost

# ============================================
# Configurações de Build
# ============================================

# Nome do aplicativo
VITE_APP_NAME=Hermes Chat

# Versão do aplicativo (sobrescreve package.json)
# VITE_APP_VERSION=1.0.0

# ============================================
# Configurações Opcionais
# ============================================

# Habilitar analytics (opcional)
# VITE_ANALYTICS_ID=

# URL de atualização (para auto-updater)
# VITE_UPDATE_URL=

# Sentry DSN para error tracking (opcional)
# VITE_SENTRY_DSN=
